45	Gói Chăm Sóc Chuyên Sâu Mẹ & Bé Toàn Diện	Gói 18 buổi phục hồi chuyên sâu — massage, tắm bé, khám sức khỏe định kỳ, dinh dưỡng, hỗ trợ cho bú và tham vấn tâm lý — tối ưu cho giai đoạn hậu sản.	goi-dich-vu	14000000.00	120	package	18	postpartum-massage,baby-bathing,mother-health-monitoring,baby-health-monitoring,nutrition-consultation,breastfeeding-support	[{"day":1,"title":"Kh\\u1EDFi \\u0111\\u1ED9ng v\\u00E0 \\u0111\\u00E1nh gi\\u00E1 ban \\u0111\\u1EA7u","description":"Y t\\u00E1 \\u0111\\u00E1nh gi\\u00E1 t\\u00ECnh tr\\u1EA1ng m\\u1EB9 v\\u00E0 b\\u00E9, th\\u1ED1ng nh\\u1EA5t m\\u1EE5c ti\\u00EAu ch\\u0103m s\\u00F3c, sau \\u0111\\u00F3 th\\u1EF1c hi\\u1EC7n c\\u00E1c h\\u1EA1ng m\\u1EE5c ch\\u00EDnh: massage ph\\u1EE5c h\\u1ED3i sau sinh, t\\u1EAFm b\\u00E9, theo d\\u00F5i s\\u1EE9c kh\\u1ECFe m\\u1EB9, theo d\\u00F5i s\\u1EE9c kh\\u1ECFe b\\u00E9, t\\u01B0 v\\u1EA5n dinh d\\u01B0\\u1EE1ng, h\\u1ED7 tr\\u1EE3 cho b\\u00FA.","serviceKeys":"postpartum-massage,baby-bathing,mother-health-monitoring,baby-health-monitoring,nutrition-consultation,breastfeeding-support"},{"day":2,"title":"Ng\\u00E0y 2: Ch\\u0103m s\\u00F3c theo li\\u1EC7u tr\\u00ECnh","description":"T\\u1EADp trung v\\u00E0o t\\u1EAFm b\\u00E9, v\\u1EC7 sinh r\\u1ED1n/da v\\u00E0 h\\u01B0\\u1EDBng d\\u1EABn thao t\\u00E1c an to\\u00E0n; ki\\u1EC3m tra d\\u1EA5u hi\\u1EC7u h\\u1ED3i ph\\u1EE5c c\\u1EE7a m\\u1EB9, v\\u1EBFt m\\u1ED5/v\\u1EBFt kh\\u00E2u v\\u00E0 m\\u1EE9c \\u0111\\u1ED9 \\u0111au; theo d\\u00F5i th\\u00E2n nhi\\u1EC7t, \\u0103n ng\\u1EE7, ti\\u1EC3u ti\\u1EC7n/ti\\u00EAu ph\\u00E2n v\\u00E0 d\\u1EA5u hi\\u1EC7u b\\u1EA5t th\\u01B0\\u1EDDng c\\u1EE7a b\\u00E9 \\u0111\\u1EC3 duy tr\\u00EC ti\\u1EBFn \\u0111\\u1ED9 ch\\u0103m s\\u00F3c \\u1ED5n \\u0111\\u1ECBnh cho m\\u1EB9 v\\u00E0 b\\u00E9.","serviceKeys":"postpartum-massage,baby-bathing,mother-health-monitoring,baby-health-monitoring,nutrition-consultation,breastfeeding-support"},{"day":3,"title":"Ng\\u00E0y 3: Theo d\\u00F5i ti\\u1EBFn tri\\u1EC3n","description":"Th\\u1EF1c hi\\u1EC7n ki\\u1EC3m tra d\\u1EA5u hi\\u1EC7u h\\u1ED3i ph\\u1EE5c c\\u1EE7a m\\u1EB9, v\\u1EBFt m\\u1ED5/v\\u1EBFt kh\\u00E2u v\\u00E0 m\\u1EE9c \\u0111\\u1ED9 \\u0111au; theo d\\u00F5i th\\u00E2n nhi\\u1EC7t, \\u0103n ng\\u1EE7, ti\\u1EC3u ti\\u1EC7n/ti\\u00EAu ph\\u00E2n v\\u00E0 d\\u1EA5u hi\\u1EC7u b\\u1EA5t th\\u01B0\\u1EDDng c\\u1EE7a b\\u00E9; t\\u01B0 v\\u1EA5n th\\u1EF1c \\u0111\\u01A1n, b\\u1ED5 sung n\\u01B0\\u1EDBc/s\\u1EEFa v\\u00E0 c\\u00E1c m\\u00F3n ph\\u00F9 h\\u1EE3p giai \\u0111o\\u1EA1n sau sinh, ghi nh\\u1EADn ph\\u1EA3n h\\u1ED3i c\\u1EE7a gia \\u0111\\u00ECnh v\\u00E0 \\u0111i\\u1EC1u ch\\u1EC9nh nh\\u1ECBp ch\\u0103m s\\u00F3c n\\u1EBFu c\\u1EA7n.","serviceKeys":"postpartum-massage,baby-bathing,mother-health-monitoring,baby-health-monitoring,nutrition-consultation,breastfeeding-support"},{"day":4,"title":"Ng\\u00E0y 4: Ch\\u0103m s\\u00F3c theo li\\u1EC7u tr\\u00ECnh","description":"T\\u1EADp trung v\\u00E0o theo d\\u00F5i th\\u00E2n nhi\\u1EC7t, \\u0103n ng\\u1EE7, ti\\u1EC3u ti\\u1EC7n/ti\\u00EAu ph\\u00E2n v\\u00E0 d\\u1EA5u hi\\u1EC7u b\\u1EA5t th\\u01B0\\u1EDDng c\\u1EE7a b\\u00E9; t\\u01B0 v\\u1EA5n th\\u1EF1c \\u0111\\u01A1n, b\\u1ED5 sung n\\u01B0\\u1EDBc/s\\u1EEFa v\\u00E0 c\\u00E1c m\\u00F3n ph\\u00F9 h\\u1EE3p giai \\u0111o\\u1EA1n sau sinh; ki\\u1EC3m tra kh\\u1EDBp ng\\u1EADm, t\\u01B0 th\\u1EBF cho b\\u00FA v\\u00E0 x\\u1EED l\\u00FD c\\u0103ng/t\\u1EAFc tia s\\u1EEFa \\u0111\\u1EC3 duy tr\\u00EC ti\\u1EBFn \\u0111\\u1ED9 ch\\u0103m s\\u00F3c \\u1ED5n \\u0111\\u1ECBnh cho m\\u1EB9 v\\u00E0 b\\u00E9.","serviceKeys":"postpartum-massage,baby-bathing,mother-health-monitoring,baby-health-monitoring,nutrition-consultation,breastfeeding-support"},{"day":5,"title":"Ng\\u00E0y 5: Ch\\u0103m s\\u00F3c theo li\\u1EC7u tr\\u00ECnh","description":"T\\u1EADp trung v\\u00E0o t\\u01B0 v\\u1EA5n th\\u1EF1c \\u0111\\u01A1n, b\\u1ED5 sung n\\u01B0\\u1EDBc/s\\u1EEFa v\\u00E0 c\\u00E1c m\\u00F3n ph\\u00F9