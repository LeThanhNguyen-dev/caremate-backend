# MomCare API Configuration Template
# Copy this file to .env and update with your actual values

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Database Connection
# For Local Development: Use LocalDB or SQL Server Express
# Format for SQL Server:
#   Server=localhost\SQLEXPRESS;Database=MomCareDb;Trusted_Connection=true;
#   Server=.;Database=MomCareDb;User Id=sa;Password=your_password;
ConnectionStrings__DefaultConnection=Server=localhost;Database=MomCareDb;Trusted_Connection=true;TrustServerCertificate=true;

# JWT Configuration
# SecretKey should be long (min 32 chars for HS256, recommended 64+ for security)
JwtSettings__SecretKey=your_super_secret_key_at_least_32_characters_long_for_security
JwtSettings__Issuer=MomCareApi
JwtSettings__Audience=MomCareClient
JwtSettings__ExpirationMinutes=60

# Seed Data
# Set to true to auto-populate database with sample data on first run
SeedData__Enabled=true

# Optional: OAuth Provider Credentials
# Google OAuth (for third-party login)
# Auth__Google__ClientId=your_google_client_id
# Auth__Google__ClientSecret=your_google_client_secret

# Facebook OAuth
# Auth__Facebook__AppId=your_facebook_app_id
# Auth__Facebook__AppSecret=your_facebook_app_secret

# Email Configuration (if using email notifications)
# Email__SmtpServer=smtp.gmail.com
# Email__SmtpPort=587
# Email__SenderEmail=your_sender_email@gmail.com
# Email__SenderPassword=your_app_password

# Logging Level
# Options: Trace, Debug, Information, Warning, Error, Critical
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Application Settings
AppSettings__SiteUrl=https://localhost:5001
AppSettings__ApiVersion=v1
